# Required for NotebookLM Enterprise notebook/source/audio overview APIs.
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012

# Required only for the standalone Podcast API tools.
GOOGLE_CLOUD_PROJECT_ID=my-gcp-project-id

# One of: global, us, eu.
NOTEBOOKLM_ENDPOINT_LOCATION=global

# Usually global, us, or eu, depending on the NotebookLM Enterprise data location.
NOTEBOOKLM_LOCATION=global

# Optional. If unset, the server uses Google Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-or-adc.json

# Optional escape hatch for short-lived local testing:
# NOTEBOOKLM_ACCESS_TOKEN="$(gcloud auth print-access-token)"
